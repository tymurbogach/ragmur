# Entorno y dependencias
.venv/
__pycache__/
*.py[cod]

# Cachés de herramientas
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Secretos y configuración local
.env
.env.*
!.env.example

# Modelos de ML descargados
models/
.cache/huggingface/
storage/

# Evaluación: se versionan los resúmenes por ejecución, no los volcados por consulta
eval/results/**/per_query/
eval/results/*details*.json
/tmp/nli-*-details*.json

# Andamiaje local de etiquetado NLI (caché de PDFs, candidatos y progreso)
eval/.pdf_cache/
eval/eu_candidates_280.yaml
eval/labeling_bundle*.json
eval/labels_*.json

# Ajustes locales de Claude Code (la skill del proyecto sí se versiona)
.claude/settings.local.json
