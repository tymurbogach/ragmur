# Copiar a .env y ajustar. El fichero .env no se versiona.

# --- PostgreSQL ---
# Estas tres las lee docker-compose para crear el contenedor.
POSTGRES_USER=ragmur
POSTGRES_PASSWORD=ragmur
POSTGRES_DB=ragmur
POSTGRES_PORT=5432

# Y esta la lee la aplicación. El driver asyncpg va en el esquema de la URL.
DATABASE_URL=postgresql+asyncpg://ragmur:ragmur@localhost:5432/ragmur

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ragmur_chunks

# --- Servicio ---
LOG_LEVEL=INFO
API_KEY_HMAC_SECRET=replace-with-a-random-server-secret

# --- Ingesta ---
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=20971520
MAX_JSON_BODY_BYTES=65536
MULTIPART_OVERHEAD_BYTES=65536
MAX_EXTRACTED_CHARS=5000000
MAX_DOCX_EXPANDED_BYTES=52428800
MAX_PDF_PAGES=500
PDF_MIN_CHARS_PER_PAGE=10
EXTRACTION_TIMEOUT_SECONDS=120
INGESTION_MAX_JOBS=8
UPLOAD_MAX_CONCURRENT=8
UPLOAD_TIMEOUT_SECONDS=120
INGESTION_MAX_ACTIVE=2
ORPHAN_MIN_AGE_SECONDS=3600
DOCUMENT_LIST_MAX_LIMIT=100
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Modelos ---
EMBEDDING_DEVICE=auto
MODEL_CACHE_DIR=./models/huggingface
EMBEDDING_BATCH_SIZE=16
RERANKER_BATCH_SIZE=8
INDEX_BATCH_SIZE=64
BM25_LANGUAGE=spanish
BM25_DISABLE_STEMMER=false
BM25_K=1.2
BM25_B=0.75
BM25_AVG_LEN=256
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_REVISION=b5113eb38ab63efdd7f280f8c144ea8b13f978ce
NLI_BATCH_SIZE=8
VERIFY_MAX_WINDOWS=2000
VERIFY_MAX_ANSWER_CHARS=4096
VERIFY_MAX_CLAIMS=20
VERIFY_MAX_CHUNKS=20
VERIFY_MAX_PAIRS=400
VERIFY_SUPPORTED_THRESHOLD=0.75
VERIFY_WEAK_THRESHOLD=0.5
VERIFY_CONTRADICTION_THRESHOLD=0.75
SEARCH_MAX_QUERY_CHARS=4096
SEARCH_MAX_CANDIDATES=100
SEARCH_MAX_DOCUMENT_IDS=100
RRF_K=2
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_KEYS=10000
INFERENCE_MAX_REQUESTS=16

# --- LLM (fase 2) ---
# Puerta única: src/ragmur/llm/provider.py. El modelo nombra al proveedor con
# prefijo LiteLLM (p. ej. lm_studio/qwen3:8b, ollama/qwen3:8b).
# Nota: litellm 1.108.2 no trae ruta opencode_go/; OpenCode Go se usa con
# prefijo openai/ más api_base y cabecera de sesión (ver ejemplo b).
LLM_MODEL=
# Clave del proveedor remoto; los proveedores locales no la necesitan.
LLM_API_KEY=
# Base URL solo para proveedores locales o compatibles (Ollama, LM Studio).
LLM_API_BASE=
# Cabeceras extra por petición, en JSON (p. ej. sesión de OpenCode Go).
# Comentada por defecto: una línea vacía (`LLM_EXTRA_HEADERS=`) rompería el
# arranque, porque una cadena vacía no es un JSON válido.
# LLM_EXTRA_HEADERS={}
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=512
LLM_MAX_RETRIES=2
#
# Ejemplo (a): LM Studio local.
# LLM_MODEL=lm_studio/qwen3:8b
# LLM_API_BASE=http://127.0.0.1:1234/v1
#
# Ejemplo (b): OpenCode Go (ruta OpenAI-compatible).
# LLM_MODEL=openai/glm-5.3-flash
# LLM_API_BASE=https://opencode.ai/zen/go/v1
# LLM_EXTRA_HEADERS={"x-opencode-session":"<stable id>","User-Agent":"ragmur/0.1"}
# Aviso: OpenCode Go reparte un cupo compartido (tráfico de agentes, monitorizado);
# el banco de pruebas usa el modelo local y Go queda para humo puntual.
