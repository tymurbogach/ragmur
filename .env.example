# Copiar a .env y ajustar. El fichero .env no se versiona.

# --- PostgreSQL ---
# Estas tres las lee docker-compose para crear el contenedor.
POSTGRES_USER=ragmur
POSTGRES_PASSWORD=ragmur
POSTGRES_DB=ragmur
POSTGRES_PORT=5432

# Y esta la lee la aplicación. El driver asyncpg va en el esquema de la URL.
DATABASE_URL=postgresql+asyncpg://ragmur:ragmur@localhost:5432/ragmur

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# --- Servicio ---
LOG_LEVEL=INFO
