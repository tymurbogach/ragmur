# Copiar a .env y ajustar. El fichero .env no se versiona.

# --- PostgreSQL ---
# Estas tres las lee docker-compose para crear el contenedor.
POSTGRES_USER=ragmur
POSTGRES_PASSWORD=ragmur
POSTGRES_DB=ragmur
POSTGRES_PORT=5432

# Y esta la lee la aplicación. El driver asyncpg va en el esquema de la URL.
DATABASE_URL=postgresql+asyncpg://ragmur:ragmur@localhost:5432/ragmur

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# --- Servicio ---
LOG_LEVEL=INFO
API_KEY_HMAC_SECRET=replace-with-a-random-server-secret

# --- Ingesta ---
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=20971520
MULTIPART_OVERHEAD_BYTES=65536
MAX_EXTRACTED_CHARS=5000000
MAX_DOCX_EXPANDED_BYTES=52428800
MAX_PDF_PAGES=500
PDF_MIN_CHARS_PER_PAGE=10
EXTRACTION_TIMEOUT_SECONDS=120
INGESTION_MAX_JOBS=8
INGESTION_MAX_ACTIVE=2
ORPHAN_MIN_AGE_SECONDS=3600
DOCUMENT_LIST_MAX_LIMIT=100
CHUNK_SIZE=800
CHUNK_OVERLAP=120
